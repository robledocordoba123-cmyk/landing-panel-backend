{
  "name": "huellitas-api",
  "version": "1.0.0",
  "description": "API de la landing de Huellitas Veterinaria: solicitudes de cita y panel con login",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "crear-admin": "node scripts/crear-admin.js",
    "demo": "node scripts/demo.js",
    "start:demo": "prisma migrate deploy && DEMO=true node scripts/demo.js && MODO_DEMO=true node index.js",
    "pretest": "node tests/preparar-bd.js",
    "test": "jest --runInBand",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@parcel/watcher": false
  },
  "engines": {
    "node": "22.x"
  }
}
