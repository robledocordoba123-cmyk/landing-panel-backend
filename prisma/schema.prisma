generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mensaje {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  telefono  String?
  mensaje   String
  creadoEn  DateTime @default(now())
}

model Usuario {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}