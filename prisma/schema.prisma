generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Solicitud que llega desde el formulario de la página (pedir cita o
// preguntar algo). El negocio la ve en el panel y la marca como atendida.
model Mensaje {
  id              Int       @id @default(autoincrement())
  nombre          String
  email           String
  telefono        String?
  mascota         String?
  servicio        String?
  mensaje         String
  estado          String    @default("NUEVO") // NUEVO | ATENDIDO
  origen          String    @default("WEB") // WEB | WHATSAPP
  creadoEn        DateTime  @default(now())
  atendidoEn      DateTime?
  autorizaDatosEn DateTime?

  @@index([estado, creadoEn])
}

// Cuenta del equipo. sesionVersion cambia para cerrar sus sesiones abiertas.
model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  email         String   @unique
  password      String
  rol           String   @default("RECEPCION") // ADMIN | VETERINARIO | RECEPCION
  activo        Boolean  @default(true)
  sesionVersion Int      @default(0)
  creadoEn      DateTime @default(now())
}

// Quién hizo qué. Un disparador en PostgreSQL impide cambiarla o borrarla.
model Bitacora {
  id           Int      @id @default(autoincrement())
  usuarioId    Int?
  usuarioEmail String?
  accion       String
  entidad      String?
  entidadId    Int?
  detalle      String?
  ip           String?
  creadoEn     DateTime @default(now())

  @@index([creadoEn])
  @@index([entidad, entidadId])
}

// Prueba de la autorización de datos personales (Ley 1581 de 2012).
model AutorizacionDatos {
  id         Int      @id @default(autoincrement())
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  Int
  version    String
  canal      String // WEB | WHATSAPP
  ip         String?
  aceptadaEn DateTime @default(now())

  @@index([clienteId])
}

// Conversación en curso con el asistente de WhatsApp (o con el simulador de
// la página). Guarda en qué paso va y los datos que ya dio la persona, para
// que el bot recuerde la conversación aunque el servidor se reinicie.
model ConversacionBot {
  id            String   @id // número de WhatsApp o "sim:<id>" en el simulador
  estado        String   @default("INICIO")
  datos         Json     @default("{}")
  actualizadoEn DateTime @updatedAt
}

// Lo que ofrece la veterinaria. duracionMin define cuánto ocupa una cita y
// recurso, qué se ocupa: consulta y vacunas comparten el consultorio, y la
// peluquería tiene su propio espacio. Las urgencias no se reservan.
model Servicio {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  detalle     String
  precioDesde Int
  duracionMin Int
  recurso     String // CONSULTORIO | PELUQUERIA
  reservable  Boolean @default(true)
  citas       Cita[]
}

// Cita con fecha y hora. La regla de que dos citas no se crucen la garantiza
// PostgreSQL con la restricción cita_sin_cruces (ver la migración citas_reales).
model Cita {
  id             Int            @id @default(autoincrement())
  servicio       Servicio       @relation(fields: [servicioId], references: [id])
  servicioId     Int
  recurso        String
  inicio         DateTime
  fin            DateTime
  estado         String         @default("PENDIENTE") // PENDIENTE | CONFIRMADA | ATENDIDA | NO_ASISTIO | CANCELADA
  mascota        Mascota        @relation(fields: [mascotaId], references: [id])
  mascotaId      Int
  atencion       Atencion?
  notas          String?
  recordatorioEn DateTime?
  notificaciones Notificacion[]
  origen         String         @default("WEB") // WEB | WHATSAPP
  creadoEn       DateTime       @default(now())
  actualizadoEn  DateTime       @updatedAt

  @@index([inicio])
  @@index([mascotaId])
}

// Quien reserva. El correo lo identifica, para reunir sus citas y mascotas.
model Cliente {
  id             Int                 @id @default(autoincrement())
  nombre         String
  email          String              @unique
  telefono       String?
  creadoEn       DateTime            @default(now())
  anonimizadoEn  DateTime?
  mascotas       Mascota[]
  autorizaciones AutorizacionDatos[]
}

model Mascota {
  id              Int        @id @default(autoincrement())
  cliente         Cliente    @relation(fields: [clienteId], references: [id])
  clienteId       Int
  nombre          String
  especie         String // Perro | Gato | Ave | Conejo | Otro
  raza            String?
  sexo            String? // Macho | Hembra
  fechaNacimiento DateTime?  @db.Date
  notas           String?
  creadoEn        DateTime   @default(now())
  citas           Cita[]
  atenciones      Atencion[]
  vacunas         Vacuna[]

  @@index([clienteId])
}

// Entrada de la historia clínica. Si viene de una cita, cada cita tiene una sola.
model Atencion {
  id            Int      @id @default(autoincrement())
  mascota       Mascota  @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  mascotaId     Int
  cita          Cita?    @relation(fields: [citaId], references: [id], onDelete: SetNull)
  citaId        Int?     @unique
  fecha         DateTime @default(now())
  motivo        String
  diagnostico   String?
  tratamiento   String?
  pesoKg        Float?
  temperaturaC  Float?
  registradoPor String

  @@index([mascotaId, fecha])
}

// Carné de vacunas: cada dosis aplicada y cuándo toca la siguiente.
model Vacuna {
  id            Int       @id @default(autoincrement())
  mascota       Mascota   @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  mascotaId     Int
  nombre        String
  aplicadaEn    DateTime  @db.Date
  proximaDosis  DateTime? @db.Date
  lote          String?
  registradoPor String

  @@index([mascotaId])
  @@index([proximaDosis])
}

// Cada correo que la API intenta enviar. ENVIADA salió por Brevo; SIMULADA no
// salió porque no hay clave (la demo pública); FALLIDA no se pudo enviar.
model Notificacion {
  id           Int      @id @default(autoincrement())
  cita         Cita     @relation(fields: [citaId], references: [id], onDelete: Cascade)
  citaId       Int
  tipo         String // RESERVA | CONFIRMADA | REPROGRAMADA | RECORDATORIO | CANCELADA
  destinatario String
  asunto       String
  estado       String // ENVIADA | SIMULADA | FALLIDA
  detalle      String?
  creadoEn     DateTime @default(now())

  @@index([citaId])
  @@index([creadoEn])
}
