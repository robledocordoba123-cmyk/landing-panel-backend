# Copia este archivo a .env. .env nunca se sube a Git.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/huellitas?schema=public"
# Secreto largo y aleatorio para firmar los tokens del panel.
JWT_SECRET="cambia-esto-por-un-secreto-largo"
# URL(s) del frontend que pueden llamar a la API, separadas por coma.
CORS_ORIGIN="http://localhost:5173"
PORT=3001
# Solo en producción: cuántos proxies hay delante de la API (en Render son 3).
# TRUST_PROXY=3

# Asistente de WhatsApp (opcional). Sin estas variables el webhook responde 404.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
# IA para preguntas libres (opcional).
# ANTHROPIC_API_KEY=""
# BOT_IA_MODELO="claude-haiku-5-5"
